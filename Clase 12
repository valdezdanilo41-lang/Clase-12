#include <iostream>
#include <fstream>
#include <string>
#include <limits> // Para limpiar el buffer de entrada

using namespace std;

// ==========================================
// 1. DEFINICIÓN DE ESTRUCTURA
// ==========================================
struct Personaje {
    string nombre;
    int vida;
    int ataque;
};

// ==========================================
// PROTOTIPOS DE FUNCIONES
// ==========================================
void registrarPersonaje();
void verPersonajes();
void mostrarMenu();

// ==========================================
// FUNCIÓN PRINCIPAL (CONTROLADOR DEL MENÚ)
// ==========================================
int main() {
    int opcion;

    do {
        mostrarMenu();
        cout << "Elija una opcion: ";
        cin >> opcion;

        // Limpieza de buffer para evitar errores al leer strings despues de un int
        cin.ignore(numeric_limits<streamsize>::max(), '\n'); 

        switch (opcion) {
            case 1:
                registrarPersonaje();
                break;
            case 2:
                verPersonajes();
                break;
            case 3:
                cout << "Saliendo del programa..." << endl;
                break;
            default:
                cout << "Opcion invalida. Intente de nuevo." << endl;
        }

        cout << endl; // Linea en blanco para mayor claridad

    } while (opcion != 3);

    return 0;
}

// ==========================================
// DEFINICIÓN DE FUNCIONES
// ==========================================

// Muestra las opciones del menú interactivo
void mostrarMenu() {
    cout << "--- MENU INTERACTIVO ---" << endl;
    cout << "[1] Registrar nuevo personaje" << endl;
    cout << "[2] Ver todos los personajes guardados" << endl;
    cout << "[3] Salir" << endl;
    cout << "------------------------" << endl;
}

