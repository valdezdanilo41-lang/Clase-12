// 3. CONSULTA Y LECTURA
// Lee todos los personajes del archivo y los muestra por consola
void verPersonajes() {
    ifstream archivo;
    archivo.open("personajes.txt");

    if (archivo.is_open()) {
        cout << "\n--- LISTA DE PERSONAJES ---" << endl;
        string linea;
        // 3. CONSULTA Y LECTURA: Uso de getline() para leer linea por linea
        while (getline(archivo, linea)) {
            // El formato es: Nombre,Vida,Ataque
            // Usaremos find y substr para extraer los datos
            size_t coma1 = linea.find(',');
            size_t coma2 = linea.rfind(',');

            if (coma1 != string::npos && coma2 != string::npos && coma1 != coma2) {
                string nombre = linea.substr(0, coma1);
                string vidaStr = linea.substr(coma1 + 1, coma2 - coma1 - 1);
                string ataqueStr = linea.substr(coma2 + 1);

                cout << "Nombre: " << nombre 
                     << "\t | Vida: " << vidaStr 
                     << "\t | Ataque: " << ataqueStr << endl;
            } else {
                // Si la linea no tiene el formato correcto, podemos mostrar una advertencia o simplemente saltarla
                // Para este ejercicio, asumiremos formato correcto, pero es buena práctica gestionarlo.
            }
        }
        cout << "------------------------" << endl;
        
        // 5. BUENAS PRÁCTICAS: Cierre explícito del archivo
        archivo.close();
    } else {
        cerr << "Error: No se pudo abrir el archivo personajes.txt para lectura. Asegurese de haber registrado al menos un personaje." << endl;
    }
}
